.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #0c2238 0%, #173b57 28%, #eef4f9 28%, #f6f9fc 100%);
}

.hero-card,
.form-card {
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
}

.hero-card {
  padding: 34rpx 30rpx;
  background: linear-gradient(145deg, rgba(9, 30, 48, 0.98) 0%, rgba(23, 73, 103, 0.9) 100%);
  color: #f8fafc;
}

.hero-badge,
.field-label,
.switch-title,
.save-button {
  font-weight: 700;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #d7f7f1;
  font-size: 22rpx;
}

.hero-title,
.hero-subtitle,
.field-label,
.switch-desc {
  display: block;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 48rpx;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(240, 249, 255, 0.88);
}

.form-card {
  margin-top: 24rpx;
  padding: 30rpx 26rpx 34rpx;
  background: rgba(255, 255, 255, 0.98);
}

.field + .field,
.switch-card,
.save-button {
  margin-top: 24rpx;
}

.field-label {
  font-size: 28rpx;
  color: #0f172a;
}

.field-input,
.field-textarea {
  width: 100%;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #f5f8fb;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 1.6;
}

.field-input {
  height: 88rpx;
  line-height: 88rpx;
}

.field-textarea {
  padding: 24rpx 22rpx;
  min-height: 180rpx;
}

.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: #eef7f5;
}

.switch-copy {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.switch-title {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
}

.switch-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #526071;
}

.save-button {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 30rpx;
  background: linear-gradient(135deg, #0f9f7f 0%, #0b6b68 100%);
  box-shadow: 0 24rpx 44rpx rgba(15, 159, 127, 0.22);
}
