.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 180rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #0c2238 0%, #173b57 26%, #eef4f9 26%, #f6f9fc 100%);
}

.hero-card,
.panel {
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
}

.hero-card {
  padding: 36rpx 30rpx 34rpx;
  text-align: center;
  background: linear-gradient(145deg, rgba(9, 30, 48, 0.98) 0%, rgba(23, 73, 103, 0.9) 100%);
  color: #f8fafc;
}

.hero-badge,
.panel-title,
.summary-label,
.station-name,
.flow-title,
.task-name,
.subheading,
.scan-button,
.ghost-button {
  font-weight: 700;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #d7f7f1;
  font-size: 22rpx;
}

.hero-title,
.hero-subtitle,
.panel-title,
.summary-label,
.station-meta,
.flow-desc,
.task-meta,
.guidance-item,
.empty-desc {
  display: block;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 48rpx;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(240, 249, 255, 0.88);
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx 26rpx 32rpx;
  background: rgba(255, 255, 255, 0.98);
}

.panel-title {
  font-size: 30rpx;
  color: #0f172a;
}

.panel-title--center {
  text-align: center;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.summary-card,
.station-card,
.verify-tools,
.task-card,
.empty-card {
  margin-top: 20rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: #f5f8fb;
}

.summary-card {
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.summary-label {
  font-size: 22rpx;
  color: #64748b;
}

.summary-value {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #0f172a;
}

.station-name {
  display: block;
  font-size: 30rpx;
  color: #0f172a;
}

.station-meta,
.flow-desc,
.task-meta,
.guidance-item,
.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.72;
  color: #526071;
}

.flow-item {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
}

.flow-index {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #0b2239;
  background: linear-gradient(135deg, #bfe9ff 0%, #dff7ff 100%);
}

.flow-copy {
  flex: 1;
  padding-left: 18rpx;
}

.flow-title {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
}

.verify-tools {
  background: #eef7f5;
}

.scan-button,
.ghost-button {
  border-radius: 999rpx;
  font-size: 28rpx;
}

.scan-button {
  color: #ffffff;
  background: linear-gradient(135deg, #0f9f7f 0%, #0b6b68 100%);
}

.ghost-button {
  margin-top: 16rpx;
  color: #12314a;
  background: #e7eef7;
}

.verify-input {
  width: 100%;
  margin-top: 16rpx;
  height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 28rpx;
  color: #0f172a;
}

.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-name {
  font-size: 30rpx;
  color: #0f172a;
}

.task-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.task-status--active {
  color: #0f766e;
  background: #ddf5f1;
}

.task-status--done {
  color: #047857;
  background: #d1fae5;
}

.item-list {
  margin-top: 18rpx;
}

.subheading {
  display: block;
  font-size: 26rpx;
  color: #0f172a;
}

.item-chip {
  display: inline-block;
  margin-top: 14rpx;
  margin-right: 14rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #12314a;
  font-size: 22rpx;
}

.guidance-box {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #dde6f0;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}
