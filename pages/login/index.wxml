<view class="page">
  <view class="hero-card">
    <text class="hero-badge">身份登录</text>
    <text class="hero-title">扫码识别你的服务身份</text>
  </view>

  <view class="panel">
    <text class="panel-title panel-title--center">选择身份</text>
    <view class="role-grid">
      <block wx:for="{{roleOptions}}" wx:key="key">
        <button
          class="role-card {{selectedRoleKey === item.key ? 'role-card--active' : ''}}"
          bindtap="handleRoleSelect"
          data-key="{{item.key}}"
        >
          <text class="role-name">{{item.label}}</text>
          <text class="role-desc">{{item.description}}</text>
        </button>
      </block>
    </view>
  </view>

  <view class="panel">
    <text class="panel-title panel-title--center">二维码识别</text>
    <view class="scan-card">
      <text class="scan-title">身份码</text>
      <button class="scan-button" bindtap="handleScanIdentity">扫码识别身份</button>
      <input
        class="field-input"
        value="{{identityCodeInput}}"
        placeholder="身份码（扫码后自动填充）"
        placeholder-style="color:#94A3B8;font-size:26rpx;"
        bindinput="handleIdentityInput"
      />
      <button class="ghost-button" bindtap="handleResolveIdentity">识别身份码</button>
    </view>

    <view wx:if="{{identityProfile}}" class="identity-card">
      <text class="identity-name">{{identityProfile.name}}</text>
      <text class="identity-meta">{{identityProfile.title}}</text>
      <text class="identity-meta">{{identityProfile.community || identityProfile.organization}}</text>
      <text class="identity-code">{{identityProfile.code}}</text>
    </view>
  </view>

  <view class="panel">
    <text class="panel-title panel-title--center">完善登录资料</text>

    <view class="field">
      <text class="field-label">姓名</text>
      <input
        class="field-input"
        value="{{name}}"
        placeholder="请输入姓名"
        placeholder-style="color:#94A3B8;font-size:26rpx;"
        bindinput="handleNameInput"
      />
    </view>

    <view class="field">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        maxlength="20"
        value="{{phone}}"
        placeholder="请输入联系方式"
        placeholder-style="color:#94A3B8;font-size:26rpx;"
        bindinput="handlePhoneInput"
      />
    </view>

    <view class="field">
      <text class="field-label">社区 / 机构</text>
      <input
        class="field-input"
        value="{{organization}}"
        placeholder="请输入所属社区或机构"
        placeholder-style="color:#94A3B8;font-size:26rpx;"
        bindinput="handleOrganizationInput"
      />
    </view>

    <label class="agreement-row">
      <checkbox
        value="agree"
        checked="{{agreementChecked}}"
        color="#0f9f7f"
        bindchange="handleAgreementChange"
      />
      <text class="agreement-text">我已阅读并同意服务说明与隐私告知</text>
    </label>

    <button class="submit-button" bindtap="handleLogin">完成登录</button>
    <button wx:if="{{sessionReady}}" class="plain-button" bindtap="handleLogout">退出当前身份</button>
    <button class="plain-button plain-button--alert" bindtap="handleEmergency120">紧急联动 120</button>
  </view>
</view>
