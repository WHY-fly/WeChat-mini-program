.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 180rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #0c2238 0%, #173b57 26%, #eef4f9 26%, #f6f9fc 100%);
}

.hero-card,
.panel {
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
}

.hero-card {
  padding: 36rpx 30rpx 34rpx;
  text-align: center;
  background: linear-gradient(145deg, rgba(9, 30, 48, 0.98) 0%, rgba(23, 73, 103, 0.9) 100%);
  color: #f8fafc;
}

.hero-badge,
.panel-title,
.role-name,
.scan-title,
.field-label,
.submit-button {
  font-weight: 700;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #d7f7f1;
  font-size: 22rpx;
}

.hero-title,
.hero-subtitle,
.panel-title,
.role-desc,
.scan-desc,
.field-label,
.identity-meta,
.identity-code,
.agreement-text {
  display: block;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 48rpx;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(240, 249, 255, 0.88);
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx 26rpx 32rpx;
  background: rgba(255, 255, 255, 0.98);
  overflow: hidden;
}

.panel-title {
  font-size: 30rpx;
  color: #0f172a;
}

.panel-title--center {
  text-align: center;
}

.role-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16rpx;
  margin: 24rpx auto 0;
  width: 100%;
  box-sizing: border-box;
}

.role-card {
  width: 100%;
  min-width: 0;
  min-height: 136rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  text-align: left;
  background: #f5f8fb;
  border: 2rpx solid transparent;
  overflow: hidden;
  line-height: 1.4;
}

.role-card--active {
  border-color: #0f9f7f;
  background: #eaf7f4;
}

.role-name {
  width: 100%;
  font-size: 28rpx;
  color: #0f172a;
}

.role-desc {
  width: 100%;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #526071;
  word-break: break-word;
}

.scan-card,
.identity-card {
  margin-top: 24rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: #f5f8fb;
}

.scan-title {
  font-size: 28rpx;
  color: #0f172a;
}

.scan-desc,
.identity-meta,
.identity-code {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.72;
  color: #526071;
}

.scan-button,
.ghost-button,
.submit-button,
.plain-button,
.test-chip {
  margin-top: 18rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.scan-button,
.submit-button {
  color: #ffffff;
  background: linear-gradient(135deg, #0f9f7f 0%, #0b6b68 100%);
}

.ghost-button,
.plain-button {
  color: #12314a;
  background: #eef4fb;
}

.plain-button--alert {
  color: #b91c1c;
  background: #fff1f2;
}

.test-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.test-chip {
  min-height: 64rpx;
  margin-top: 0;
  padding: 0 18rpx;
  line-height: 64rpx;
  font-size: 22rpx;
  color: #0b6b68;
  background: #eaf7f4;
}

.field {
  margin-top: 22rpx;
}

.field-label {
  font-size: 26rpx;
  color: #0f172a;
}

.field-input {
  width: 100%;
  margin-top: 12rpx;
  height: 88rpx;
  padding: 0 22rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #f5f8fb;
  color: #0f172a;
  font-size: 28rpx;
}

.identity-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.agreement-row {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.agreement-text {
  padding-left: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #526071;
}
