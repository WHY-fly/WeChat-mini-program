.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 180rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #0c2238 0%, #173b57 26%, #eef4f9 26%, #f6f9fc 100%);
}

.hero-card,
.panel {
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
}

.hero-card {
  padding: 36rpx 30rpx 34rpx;
  text-align: center;
  background: linear-gradient(145deg, rgba(9, 30, 48, 0.98) 0%, rgba(23, 73, 103, 0.9) 100%);
  color: #f8fafc;
}

.hero-badge,
.panel-title,
.summary-label,
.action-button {
  font-weight: 700;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #d7f7f1;
  font-size: 22rpx;
}

.hero-title,
.hero-subtitle,
.panel-title,
.summary-label {
  display: block;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 48rpx;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(240, 249, 255, 0.88);
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx 26rpx 32rpx;
  background: rgba(255, 255, 255, 0.98);
}

.panel-title {
  font-size: 30rpx;
  color: #0f172a;
}

.panel-title--center {
  text-align: center;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.summary-card {
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: #f5f8fb;
}

.summary-label {
  font-size: 22rpx;
  color: #64748b;
}

.summary-value {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #0f172a;
}

.action-button {
  margin-top: 18rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f9f7f 0%, #0b6b68 100%);
}

.action-button--plain {
  color: #12314a;
  background: #e7eef7;
}

.action-button--alert {
  color: #b91c1c;
  background: #fff1f2;
}

.action-button--danger {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
}
