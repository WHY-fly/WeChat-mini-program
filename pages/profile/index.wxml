<view class="page">
  <view class="hero-card">
    <text class="hero-badge">我的服务身份</text>
    <text class="hero-title">{{currentSession ? currentSession.name : '未登录'}}</text>
    <text class="hero-subtitle">
      {{currentSession ? currentSession.roleLabel + ' · ' + (currentSession.organization || currentSession.community || currentSession.address) : '当前未登录，可先前往身份页完成登录；紧急情况也可直接联动 120。'}}
    </text>
  </view>

  <view class="panel">
    <text class="panel-title panel-title--center">当前概览</text>
    <view class="summary-grid">
      <view class="summary-card">
        <text class="summary-label">身份码</text>
        <text class="summary-value">{{currentSession ? currentSession.identityCode : '待登录'}}</text>
      </view>
      <view class="summary-card">
        <text class="summary-label">服务关系</text>
        <text class="summary-value">{{residentCount}} 条</text>
      </view>
      <view class="summary-card">
        <text class="summary-label">投送任务</text>
        <text class="summary-value">{{supplyCount}} 单</text>
      </view>
      <view class="summary-card">
        <text class="summary-label">联系方式</text>
        <text class="summary-value">{{currentSession ? currentSession.phone : '待补充'}}</text>
      </view>
    </view>
  </view>

  <view class="panel">
    <text class="panel-title panel-title--center">账号与热线</text>
    <button wx:if="{{!currentSession}}" class="action-button" bindtap="goLogin">去登录</button>
    <button class="action-button action-button--plain" bindtap="openRouteEditor">维护紧急热线</button>
    <button class="action-button action-button--alert" bindtap="callEmergency120">紧急联动 120</button>
    <button wx:if="{{currentSession}}" class="action-button action-button--danger" bindtap="logout">退出登录</button>
  </view>
</view>
