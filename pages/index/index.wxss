.page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 24rpx 180rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    linear-gradient(180deg, #0c2238 0%, #173b57 24%, #edf3f8 24%, #f5f8fb 100%);
}

.aurora {
  position: absolute;
  z-index: 0;
  border-radius: 999rpx;
  filter: blur(12rpx);
  opacity: 0.5;
}

.aurora--top {
  top: 8rpx;
  right: -70rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(81, 210, 193, 0.44) 0%, rgba(81, 210, 193, 0) 72%);
}

.aurora--bottom {
  top: 420rpx;
  left: -90rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(122, 169, 255, 0.2) 0%, rgba(122, 169, 255, 0) 72%);
}

.hero-card,
.dashboard-card,
.countdown-card,
.panel {
  position: relative;
  z-index: 1;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
}

.hero-card {
  padding: 36rpx 30rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(145deg, rgba(9, 30, 48, 0.98) 0%, rgba(23, 73, 103, 0.9) 100%);
  color: #f8fafc;
}

.hero-badge,
.panel-title,
.session-title,
.countdown-title,
.route-value,
.service-name,
.preview-title,
.flow-title,
.contact-name,
.primary-button,
.secondary-button,
.outline-button {
  font-weight: 700;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #d7f7f1;
  font-size: 22rpx;
}

.hero-title,
.hero-subtitle,
.panel-title,
.session-subtitle,
.section-eyebrow,
.status-text,
.route-label,
.route-meta,
.service-desc,
.preview-desc,
.flow-desc,
.contact-desc {
  display: block;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 52rpx;
  line-height: 1.18;
}

.hero-subtitle {
  max-width: 620rpx;
  margin: 20rpx auto 0;
  font-size: 30rpx;
  line-height: 1.7;
  color: rgba(240, 249, 255, 0.92);
}

.scene-tag-row,
.session-tag-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.scene-tag,
.session-tag,
.contact-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.scene-tag {
  background: rgba(255, 255, 255, 0.08);
  color: #e2f1ff;
}

.dashboard-card,
.panel,
.countdown-card {
  margin-top: 24rpx;
  padding: 30rpx 26rpx 32rpx;
  background: rgba(255, 255, 255, 0.98);
}

.panel-title {
  font-size: 30rpx;
  color: #0f172a;
}

.panel-title--center {
  text-align: center;
}

.session-title {
  margin-top: 22rpx;
  text-align: center;
  font-size: 34rpx;
  color: #0f172a;
}

.session-subtitle {
  margin-top: 14rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.72;
  color: #526071;
}

.session-tag {
  background: #eef4fb;
  color: #12314a;
}

.countdown-card {
  border: 2rpx solid rgba(14, 116, 144, 0.08);
}

.countdown-card--warning {
  border-color: rgba(245, 158, 11, 0.28);
}

.countdown-card--success {
  border-color: rgba(34, 197, 94, 0.22);
}

.countdown-card--danger {
  border-color: rgba(239, 68, 68, 0.22);
}

.countdown-card--neutral {
  border-color: rgba(71, 85, 105, 0.18);
}

.countdown-top,
.route-grid,
.quick-actions,
.contact-top,
.service-grid {
  display: flex;
}

.countdown-top,
.route-grid,
.contact-top {
  justify-content: space-between;
  align-items: center;
}

.countdown-top,
.route-grid {
  flex-wrap: wrap;
}

.countdown-copy {
  max-width: 460rpx;
}

.section-eyebrow {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 2rpx;
}

.countdown-title {
  margin-top: 12rpx;
  font-size: 36rpx;
  line-height: 1.35;
  color: #0f172a;
}

.countdown-badge {
  min-width: 136rpx;
  padding: 18rpx 20rpx;
  border-radius: 26rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
  background: linear-gradient(135deg, #dff8f4 0%, #eef8ff 100%);
}

.progress-track {
  height: 16rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #e2e8f0;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
}

.progress-fill--warning {
  background: linear-gradient(90deg, #f59e0b 0%, #f97316 100%);
}

.progress-fill--success {
  background: linear-gradient(90deg, #10b981 0%, #0f9f7f 100%);
}

.progress-fill--danger {
  background: linear-gradient(90deg, #ef4444 0%, #dc2626 100%);
}

.progress-fill--neutral {
  background: linear-gradient(90deg, #64748b 0%, #475569 100%);
}

.status-text {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #1e293b;
}

.route-grid {
  gap: 18rpx;
  margin-top: 24rpx;
  align-items: stretch;
}

.route-card,
.service-card,
.supply-preview-card {
  border-radius: 24rpx;
  background: #f5f8fb;
}

.route-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
}

.route-card--alert {
  background: linear-gradient(135deg, #fff4f1 0%, #fffaf6 100%);
}

.route-label {
  font-size: 22rpx;
  color: #64748b;
}

.route-value {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #0f172a;
}

.route-meta,
.service-desc,
.preview-desc,
.flow-desc,
.contact-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.72;
  color: #526071;
}

.primary-button,
.secondary-button,
.ghost-button,
.outline-button,
.contact-call {
  margin-top: 18rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
}

.primary-button,
.secondary-button,
.outline-button {
  height: 92rpx;
  line-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, #0f9f7f 0%, #0b6b68 100%);
}

.secondary-button {
  color: #0f172a;
  background: #e1edf7;
}

.outline-button {
  color: #0b6b68;
  background: #eaf7f4;
}

.quick-actions {
  gap: 18rpx;
  margin-top: 18rpx;
}

.ghost-button {
  flex: 1;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 16rpx;
  color: #12314a;
  background: #eef4fb;
}

.ghost-button--alert {
  color: #b91c1c;
  background: #fff1f2;
}

.service-grid {
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 24rpx;
}

.service-card {
  width: calc(50% - 9rpx);
  padding: 24rpx 22rpx;
  text-align: left;
}

.service-name {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
}

.supply-preview-card {
  margin-top: 22rpx;
  padding: 24rpx 22rpx;
}

.preview-title {
  display: block;
  font-size: 30rpx;
  color: #0f172a;
}

.flow-item {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
}

.flow-index {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #0b2239;
  background: linear-gradient(135deg, #bfe9ff 0%, #dff7ff 100%);
}

.flow-content {
  flex: 1;
  padding-left: 18rpx;
}

.flow-title {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e8eef5;
}

.contact-main {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.contact-name {
  font-size: 28rpx;
  color: #0f172a;
}

.contact-tag {
  margin-left: 12rpx;
  background: #ddf5f1;
  color: #0b6b68;
}

.contact-tag--muted {
  background: #f1f5f9;
  color: #64748b;
}

.contact-phone {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1e293b;
}

.contact-call {
  min-width: 168rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin-top: 10rpx;
  padding: 0 20rpx;
  color: #0f172a;
  background: #edf4fb;
}

.contact-item--primary .contact-call {
  color: #ffffff;
  background: linear-gradient(135deg, #0f9f7f 0%, #0b6b68 100%);
}
